# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram user id администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=

# --- Общие ------------------------------------------------------------------
# Файл базы SQLite
DB_PATH=data/jobspy.sqlite3
# Как часто опрашивать площадки, минут
POLL_INTERVAL_MIN=30
# Вакансии старше N дней игнорируются
MAX_VACANCY_AGE_DAYS=7
# Ограничить список площадок (через запятую). Пусто = все доступные.
# Доступные: hh_by, hh_ru, hh_kz, praca_by, habr, getmatch, superjob, justjoin, nofluffjobs, jobs_ge
ENABLED_SOURCES=
LOG_LEVEL=INFO

# --- Доступ и подписка ------------------------------------------------------
# invite — только по приглашениям (/invite) и одобрению админа
# open   — любой по /start получает пробный Pro, затем бесплатный тариф
ACCESS_MODE=invite
# Пробный период Pro, дней (0 — без пробного)
TRIAL_DAYS=7
# Цена Pro за 30 дней в Telegram Stars (0 — оплата выключена, Pro выдаёт только админ)
PRO_PRICE_STARS=250
# Контакт поддержки для страницы подписки, например @username
SUPPORT_CONTACT=

# --- Ключи площадок ---------------------------------------------------------
# SuperJob: бесплатный ключ на https://api.superjob.ru/register/
SUPERJOB_API_KEY=

# --- ИИ (любой OpenAI-совместимый API) --------------------------------------
# Примеры: https://api.openai.com/v1, https://api.deepseek.com/v1, https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Дневной лимит токенов ИИ на одного пользователя
AI_DAILY_TOKENS_PER_USER=40000
# Сколько символов описания вакансии максимум отдавать модели
AI_MAX_DESCRIPTION_CHARS=2500
# Максимум вакансий на анализ ИИ за один цикл для одного пользователя
AI_MAX_PER_CYCLE=10
# Общий дневной бюджет токенов на весь бот (0 — без общего лимита)
AI_DAILY_TOKENS_TOTAL=0
# Последние N % общего бюджета — только для Pro
AI_PRO_RESERVE_PCT=20
# Запасная модель того же провайдера, если основная не отвечает (пусто — нет)
AI_FALLBACK_MODEL=

# --- Защита, приватность, оповещения ----------------------------------------
# Сообщений и нажатий кнопок в минуту на пользователя (админы без лимита)
RATE_LIMIT_PER_MIN=30
# Загрузок файлов в сутки на пользователя
MAX_UPLOADS_PER_DAY=10
# Удалять резюме, профиль и историю тех, кто не заходил N дней (0 — не удалять)
DELETE_INACTIVE_DAYS=180
# Одинаковые ошибки админу — не чаще раза в N минут
ALERT_COOLDOWN_MIN=30
# Площадка не отдаёт вакансий дольше N часов — сообщить админу (0 — не следить)
SOURCE_SILENCE_HOURS=12

# --- Веб-админка ------------------------------------------------------------
# Включается, если заданы порт и токен. По умолчанию слушает только 127.0.0.1:
# на VPS открывайте через SSH-туннель: ssh -L 8080:127.0.0.1:8080 user@host
ADMIN_WEB_PORT=
ADMIN_WEB_HOST=127.0.0.1
# Пароль входа, не короче 16 символов:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_WEB_TOKEN=
